# Postgres-Verbindung (siehe docs/hosting-setup.md fuer Optionen)
DATABASE_URL="postgresql://user:password@localhost:5432/denkgang?schema=public"

# NextAuth
NEXTAUTH_SECRET="mit `openssl rand -base64 32` erzeugen"
NEXTAUTH_URL="http://localhost:3000"

# Nur serverseitig verwendet (Begruendungs-Auswertung), NIEMALS im Client exponieren
ANTHROPIC_API_KEY=""

# Kommagetrennte Liste von E-Mail-Adressen, die sich bei der Registrierung
# automatisch die Rolle ADMIN geben (z. B. die Produktinhaberin als Reviewerin)
ADMIN_EMAILS="gruenebergvanessa@gmail.com"
